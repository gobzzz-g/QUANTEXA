# Yahoo Finance ticker symbols (free — no API key required)
# Gold futures front-month contract
YAHOO_GOLD_TICKER=GC=F
# Bitcoin vs USD
YAHOO_BITCOIN_TICKER=BTC-USD
# NVIDIA Corporation
YAHOO_NVIDIA_TICKER=NVDA

# Date range
START_DATE=2020-01-01
END_DATE=2026-12-31

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Layer 2 – Quantitative Analysis Engine
# Risk-free rate used in Sharpe ratio calculation.
# Default: 0.0 (excess-return Sharpe).
# Replace with prevailing T-bill / risk-free rate if needed (e.g. 0.05 = 5%).
RISK_FREE_RATE=0.0

# Layer 3 – Strategy Engine
# SMA Crossover: windows must match pre-calculated values in asset_indicators (20, 50, or 200)
SMA_FAST=20
SMA_SLOW=50

# EMA Trend: windows must match pre-calculated values in asset_indicators (20, 50, or 200)
EMA_FAST=20
EMA_SLOW=50

# Momentum: number of periods to look back for close price ratio
MOMENTUM_LOOKBACK=20

# Mean Reversion: SMA window and band threshold (e.g. 0.02 = ±2%)
MEAN_REVERSION_WINDOW=20
MEAN_REVERSION_THRESHOLD=0.02

# Layer 4 – Backtesting Engine
INITIAL_CAPITAL=100000
TRANSACTION_COST=0.001
SLIPPAGE=0.0
# BACKTEST_START_DATE and BACKTEST_END_DATE default to full available period.
# Set them to restrict the backtest to a specific window (YYYY-MM-DD).
BACKTEST_START_DATE=
BACKTEST_END_DATE=
